        "additionalProperties": false,
        "properties": {
          "degraded_now": {
            "title": "Degraded Now",
            "type": "boolean"
          },
          "limit_requests": {
            "exclusiveMinimum": 0.0,
            "title": "Limit Requests",
            "type": "integer"
          },
          "limit_tokens": {
            "exclusiveMinimum": 0.0,
            "title": "Limit Tokens",
            "type": "integer"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "used_requests": {
            "minimum": 0.0,
            "title": "Used Requests",
            "type": "integer"
          },
          "used_tokens": {
            "minimum": 0.0,
            "title": "Used Tokens",
            "type": "integer"
