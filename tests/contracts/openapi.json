        "additionalProperties": false,
        "properties": {
          "config": {
            "$ref": "#/components/schemas/RunConfig"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "is_champion": {
            "title": "Is Champion",
            "type": "boolean"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "slug": {
            "pattern": "^[a-z][a-z0-9-]*$",
