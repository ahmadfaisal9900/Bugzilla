      "RunConfig": {
        "additionalProperties": false,
        "properties": {
          "context_budget_tokens": {
            "default": 3000,
            "minimum": 128.0,
            "title": "Context Budget Tokens",
            "type": "integer"
          },
          "corpus": {
            "default": "C1",
            "enum": [
              "C0",
              "C1",
              "C2"
            ],
            "title": "Corpus",
            "type": "string"
          },
          "model": {
            "default": "openai/gpt-oss-20b",
            "title": "Model",
            "type": "string"
          },
          "prompt_version": {
            "default": "answer-v1",
            "enum": [
              "answer-v1",
              "answer-v2-compact"
            ],
            "title": "Prompt Version",
            "type": "string"
          },
          "provider": {
            "default": "groq",
            "enum": [
              "groq",
              "mock"
            ],
            "title": "Provider",
            "type": "string"
          },
          "query_transform": {
            "anyOf": [
              {
                "enum": [
                  "R7a",
                  "R7b"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Query Transform"
          },
          "retriever": {
            "default": "R7b",
            "enum": [
              "R1",
              "R2",
              "R3",
              "R4",
              "R5",
              "R6",
              "R7a",
              "R7b"
            ],
            "title": "Retriever",
            "type": "string"
          },
          "rrf_k": {
            "anyOf": [
              {
                "maximum": 200.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rrf K"
          },
          "s4_tau": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "S4 Tau"
          },
          "s5_dossier_budget": {
            "anyOf": [
              {
                "minimum": 128.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "S5 Dossier Budget"
          },
          "s7_max_tool_steps": {
            "anyOf": [
              {
                "maximum": 4.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "S7 Max Tool Steps"
          },
          "system_id": {
            "default": "S2",
            "enum": [
              "R0",
              "S0",
              "S1",
              "S2",
              "S3",
              "S4",
              "S5",
              "S6",
              "S7",
              "S8",
              "ORACLE"
            ],
            "title": "System Id",
            "type": "string"
          },
          "temperature": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          },
          "top_k": {
            "default": 5,
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Top K",
            "type": "integer"
          }
        },
        "title": "RunConfig",
        "type": "object"
      },
      "StatusResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
