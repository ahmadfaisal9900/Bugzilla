{
  "components": {
    "schemas": {
      "Answer": {
        "additionalProperties": false,
        "properties": {
          "abstain": {
            "title": "Abstain",
            "type": "boolean"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "items": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "answer_type": {
            "title": "Answer Type",
            "type": "string"
          },
          "bug_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Bug Ids",
            "type": "array"
          },
          "citations": {
            "items": {
              "type": "string"
            },
            "title": "Citations",
            "type": "array"
          },
          "rationale": {
            "maxLength": 1000,
            "title": "Rationale",
            "type": "string"
          }
        },
        "required": [
          "abstain",
          "answer",
          "answer_type",
          "rationale"
        ],
        "title": "Answer",
        "type": "object"
      },
      "AnswerRecord": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          },
          "cache_hits": {
            "minimum": 0.0,
            "title": "Cache Hits",
            "type": "integer"
          },
          "config_hash": {
            "pattern": "^[a-f0-9]{12}$",
            "title": "Config Hash",
            "type": "string"
          },
          "degraded": {
            "title": "Degraded",
            "type": "boolean"
          },
          "errors": {
            "items": {
              "type": "string"
            },
            "title": "Errors",
            "type": "array"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceItem"
            },
            "title": "Evidence",
            "type": "array"
          },
          "latency_ms": {
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "llm_calls": {
            "minimum": 0.0,
            "title": "Llm Calls",
            "type": "integer"
          },
          "route": {
            "title": "Route",
            "type": "string"
          },
          "route_rule": {
            "title": "Route Rule",
            "type": "string"
          },
          "tokens": {
            "additionalProperties": true,
            "title": "Tokens",
            "type": "object"
          }
        },
        "required": [
          "answer",
          "route",
          "route_rule",
          "evidence",
          "tokens",
          "llm_calls",
          "cache_hits",
          "latency_ms",
          "degraded",
          "errors",
          "config_hash"
        ],
        "title": "AnswerRecord",
        "type": "object"
      },
      "AskResponse": {
        "additionalProperties": false,
        "properties": {
          "langsmith_run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Langsmith Run Id"
          },
          "record": {
            "$ref": "#/components/schemas/AnswerRecord"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "record"
        ],
        "title": "AskResponse",
        "type": "object"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "maxLength": 6000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "overrides": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overrides"
          },
          "preset_slug": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset Slug"
          },
          "session_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Session Id",
            "type": "string"
          }
        },
        "required": [
          "session_id",
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "invalid_config",
              "rate_limited",
              "internal"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "retry_after": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry After"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EvidenceItem": {
        "additionalProperties": false,
        "properties": {
          "bug_id": {
            "title": "Bug Id",
            "type": "string"
          },
          "chunk_id": {
            "title": "Chunk Id",
            "type": "string"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "snippet": {
            "title": "Snippet",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "chunk_id",
          "bug_id",
          "snippet",
          "score",
          "url"
        ],
        "title": "EvidenceItem",
        "type": "object"
      },
      "FeedbackRequest": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "score": {
            "enum": [
              0,
              1
            ],
            "title": "Score",
            "type": "integer"
          }
        },
        "required": [
          "request_id",
          "score"
        ],
        "title": "FeedbackRequest",
        "type": "object"
      },
      "FeedbackResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "FeedbackResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ModelOption": {
        "additionalProperties": false,
        "properties": {
          "label": {
            "title": "Label",
            "type": "string"
          },
          "max_context_tokens": {
            "exclusiveMinimum": 0.0,
            "title": "Max Context Tokens",
            "type": "integer"
          },
          "model_id": {
            "title": "Model Id",
            "type": "string"
          },
          "provider": {
            "title": "Provider",
            "type": "string"
          },
          "rpd": {
            "exclusiveMinimum": 0.0,
            "title": "Rpd",
            "type": "integer"
          },
          "rpm": {
            "exclusiveMinimum": 0.0,
            "title": "Rpm",
            "type": "integer"
          },
          "tpd": {
            "exclusiveMinimum": 0.0,
            "title": "Tpd",
            "type": "integer"
          },
          "tpm": {
            "exclusiveMinimum": 0.0,
            "title": "Tpm",
            "type": "integer"
