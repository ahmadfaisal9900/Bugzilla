# Copy this file to .env and fill in your own values. Never commit .env.

# --- Needed to run the app ---
# Your Groq API key, from https://console.groq.com/keys. Used to write the answers.
GROQ_API_KEY=replace_locally
# Optional. Select one configured key for the serving API. Restart after switching.
#SERVING_GROQ_KEY_SLOT=1
#GROQ_API_KEY_2=
#GROQ_API_KEY_3=
#GROQ_API_KEY_4=
# Any long random string. The API checks it and the chat sends it.
SERVING_API_KEY=replace_locally
# groq = real answers. mock = fake model for tests (every answer says "not enough evidence").
LLM_PROVIDER=groq
# Folder with the app's data.
BUNDLE_DIR=serving_bundle
# Where the chat finds the API.
API_URL=http://127.0.0.1:8000

# --- Dashboard ---
# Leave empty for no login on your own computer. Set a password when it's online.
DASHBOARD_PASSWORD=
# true lets the dashboard start experiment runs (needs the larger lab install). Keep false.
DASHBOARD_LAB_ENABLED=false

# --- Optional: MLflow (experiment tracking) ---
# Leave the URI commented out to use the presets in configs/presets.yaml.
#MLFLOW_TRACKING_URI=file:./outputs/mlflow-phase0
MLFLOW_TRACKING_USERNAME=replace_locally
MLFLOW_TRACKING_PASSWORD=replace_locally

# --- Optional: LangSmith (request tracing) ---
# Uncomment and add your key to turn tracing on.
#LANGSMITH_API_KEY=
# Share of questions traced (0.2 = 20%) and the most traces per day.
TRACE_SAMPLE=0.2
TRACE_DAILY_CAP=150
